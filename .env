# ===================================================
# LIBRARY MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ===================================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=MyNewPass123!
DB_NAME=LibraryDB
DB_PORT=3306

# Application Configuration
APP_TITLE=Library Management System
APP_VERSION=1.0.0

# Fine Configuration
FINE_PER_DAY=5000
DEFAULT_BORROW_DAYS=15

# Session Configuration
SESSION_TIMEOUT=3600

# ===================================================
# HƯỚNG DẪN:
# 1. Copy file này thành .env
# 2. Thay đổi DB_PASSWORD thành password MySQL của bạn
# 3. Điều chỉnh các giá trị khác nếu cần
# ===================================================